{
  "name": "gitgrove",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "desktop:dev": "node scripts/dev-desktop.mjs",
    "desktop:build": "pnpm build && node scripts/prepare-desktop.mjs && electron-builder --mac",
    "desktop:open": "open release/mac-arm64/Gitgrove.app"
  },
  "dependencies": {
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.26.1",
  "description": "Explorador visual de Git para macOS",
  "author": "Gitgrove",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.20.0"
  }
}
